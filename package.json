{
  "name": "opinonion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Zero-impact visual feedback & annotation widget for any website.",
  "scripts": {
    "build": "vite build && esbuild src/loader.js --minify --target=es2017 --outfile=dist/loader.js",
    "dev": "netlify dev",
    "dev:local": "tsx scripts/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "size": "node -e \"const f=require('fs');for(const p of ['dist/loader.js','dist/widget.js']){console.log(p,f.statSync(p).size,'bytes')}\""
  },
  "dependencies": {
    "modern-screenshot": "^4.6.0",
    "nodemailer": "^10.6.1",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@netlify/functions": "^6.1.2",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "autoprefixer": "^10.4.20",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
