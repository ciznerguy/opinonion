# Copy to .env for local `netlify dev` (never commit .env)
SITE_PASSWORD=change-me
ADMIN_EMAIL=you@example.com
# Email transport A (recommended to start): Gmail SMTP with an app password
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
# Email transport B (used only if GMAIL_* are not set): Resend
# RESEND_API_KEY=re_xxxxxxxxx
# Optional
FROM_EMAIL="OpinOnion <feedback@yourdomain.com>"
SITE_NAME=My Client Site
AUTH_SECRET=long-random-string
ALLOWED_ORIGINS=https://client1.com,https://www.client1.com
